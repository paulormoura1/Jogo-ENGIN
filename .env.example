# Private server-only key for all Gemini calls. Never use a VITE_ key or commit .env.local.
GEMINI_API_KEY=
GEMINI_REFERENCE_MODEL=gemini-3.8-flash
GEMINI_CHALLENGE_MODEL=gemini-3.8-flash

# Optional: force the complete no-Gemini flow even when keys are configured.
VITE_DISABLE_GEMINI=false
DISABLE_GEMINI=false

# Remote challenges require BOTH flags. The default uses the original local bank.
VITE_USE_GEMINI_CHALLENGES=false
ENABLE_GEMINI_CHALLENGES=false

# Leave blank when the app and research API share a host (npm run dev / npm start).
# GitHub Pages uses the bundled UFSC catalog, without a research server or Gemini.
VITE_STATIC_REFERENCES=false
# To use a separate live API, keep static mode false and set its URL below.
VITE_RESEARCH_API_URL=
# Explicit allowed frontend origins, comma-separated, without paths or wildcard.
RESEARCH_ALLOWED_ORIGINS=
# This opt-in gate is NOT authentication, especially behind a local proxy.
# Public paid access needs authentication and persistent shared quotas at a gateway.
ALLOW_REMOTE_GEMINI=false
